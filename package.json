{
  "name": "yarphoenix-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript http://127.0.0.1:5080/openapi/v1.json -o src/shared/api/schema.d.ts && prettier --write src/shared/api/schema.d.ts",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,scss,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,scss,css}\""
  },
  "dependencies": {
    "@fontsource-variable/libre-franklin": "^5.2.5",
    "@fontsource/libre-baskerville": "^5.2.5",
    "@reduxjs/toolkit": "^2.8.2",
    "epubjs": "^0.3.93",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.5.0",
    "sass": "^1.86.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  }
}
